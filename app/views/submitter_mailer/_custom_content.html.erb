<% replaced = ReplaceEmailVariables.call(local_assigns[:content], submitter: local_assigns[:submitter], sig: local_assigns[:sig]) %><% if local_assigns[:content].to_s.start_with?('<html') %><%= sanitize(replaced, tags: %w[html head body p br a strong b em i u ul ol li h1 h2 h3 div span img table tr td th style meta title link], attributes: %w[href src alt style class target rel type charset name content]) %><% else %><%= MarkdownToHtml.call(replaced) %><% end %>
