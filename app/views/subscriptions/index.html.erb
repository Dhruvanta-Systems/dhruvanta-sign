<div class="flex flex-wrap space-y-4 md:flex-nowrap md:space-y-0">
  <%= render 'shared/settings_nav' %>
  <div class="flex-grow max-w-4xl mx-auto">
    <h1 class="text-4xl font-bold mb-2">
      <%= t('plans') %>
    </h1>
    <p class="text-base-content/70 mb-6">
      Manage your on-prem subscription locally. The browser stays in this app; checkout is handled through the configured premium service.
    </p>

    <% if @success_message.present? %>
      <div class="alert alert-success mb-6">
        <%= svg_icon('circle_check', class: 'w-6 h-6') %>
        <span><%= @success_message %></span>
      </div>
    <% end %>

    <div class="alert mb-6">
      <%= svg_icon('info_circle', class: 'w-6 h-6') %>
      <span>Current plan: <strong><%= SubscriptionPlans.find(@current_plan)[:title] %></strong></span>
    </div>

    <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
      <% @plans.each do |plan_key, plan| %>
        <div class="rounded-2xl border border-base-300 bg-base-100 p-5 flex flex-col">
          <div class="flex items-start justify-between gap-3">
            <div>
              <h2 class="text-2xl font-bold"><%= plan[:title] %></h2>
              <p class="text-sm text-base-content/70 mt-1">
                <% if plan[:price_monthly] %>
                  Rs <%= plan[:price_monthly] %> / month
                <% else %>
                  Contact sales
                <% end %>
              </p>
            </div>
            <% if @current_plan == plan_key %>
              <span class="badge badge-warning">Current</span>
            <% end %>
          </div>

          <div class="mt-4 space-y-2 text-sm">
            <p>Documents: <strong><%= plan[:docs] %></strong></p>
            <p>Users: <strong><%= plan[:users] %></strong></p>
            <p>API: <strong><%= plan[:api] ? 'Included' : 'Not included' %></strong></p>
            <p>AI: <strong><%= plan[:ai] ? 'Included' : 'Not included' %></strong></p>
          </div>

          <div class="mt-6">
            <% if @current_plan == plan_key %>
              <span class="white-button w-full text-center pointer-events-none opacity-70">Active</span>
            <% else %>
              <%= form_with url: settings_subscriptions_path, method: :post, class: 'w-full' do %>
                <%= hidden_field_tag :plan, plan_key %>
                <%= hidden_field_tag :provider, @checkout_provider %>
                <button type="submit" class="base-button w-full">
                  Upgrade
                </button>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <% if @current_plan != 'free' %>
      <div class="mt-6">
        <%= button_to 'Cancel current plan', settings_subscription_path(id: @current_plan),
                      method: :delete,
                      class: 'btn btn-warning',
                      data: { turbo_confirm: 'Cancel the current plan?' } %>
      </div>
    <% end %>
  </div>
  <div class="w-0 md:w-52"></div>
</div>
