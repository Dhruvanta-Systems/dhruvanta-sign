<%# Write-only credential input: the stored value is never rendered back. Leaving it blank keeps the saved value. %>
<% is_set = cfg.value.is_a?(Hash) && cfg.value[name].present? %>
<input type="password" name="encrypted_config[value][<%= name %>]" value="" class="base-input max-w-xs" autocomplete="new-password" placeholder="<%= is_set ? 'Leave blank to keep the saved value' : '' %>">
<span class="text-xs <%= is_set ? 'text-success' : 'text-base-content/60' %>" data-secret-status="<%= name %>"><%= is_set ? 'set' : 'not set' %></span>
